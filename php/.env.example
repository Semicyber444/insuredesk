# MySQL 8.0.16+. A separate database by default, so the Next.js app's data is never touched.
# Created by `php bin/db.php migrate`. MAMP over a socket: append ?socketPath=/Applications/MAMP/tmp/mysql/mysql.sock
DATABASE_URL=mysql://root:root@127.0.0.1:8889/insuredesk_php

# Only used by `php tests/run.php`. The name must end in _test: it is dropped and rebuilt on every run.
TEST_DATABASE_URL=mysql://root:root@127.0.0.1:8889/insuredesk_php_test

# Shows the one-click demo accounts and lets them sign in without a password. Never enable in production.
ENABLE_DEMO_AUTH=true

# Set to production on a real server: the session cookie becomes Secure.
APP_ENV=development
# Set to true only if production runs over plain HTTP; otherwise browsers drop the Secure session cookie.
# SESSION_COOKIE_INSECURE=true
