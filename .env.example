# MySQL 8.0.16+ connection. MAMP's defaults are shown; the database is created by `npm run db:migrate`.
DATABASE_URL=mysql://root:root@127.0.0.1:8889/insuredesk

# Only used by `npm test`. The name must end in _test: the database is dropped and rebuilt on every run.
TEST_DATABASE_URL=mysql://root:root@127.0.0.1:8889/insuredesk_test

# Shows the one-click demo accounts and lets them sign in without a password. Never enable in production.
ENABLE_DEMO_AUTH=true

# Set to true only if production runs over plain HTTP; otherwise browsers drop the Secure session cookie.
# SESSION_COOKIE_INSECURE=true
